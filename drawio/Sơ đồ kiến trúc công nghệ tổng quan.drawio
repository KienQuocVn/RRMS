        <mxCell id="node_mobile_tech" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;align=center;" value="Mobile App (Android/iOS)&#xa;[React Native &amp; TypeScript]&#xa;- Expo SDK 54&#xa;- Expo Router (File-based)&#xa;- Zustand State Manager&#xa;- AsyncStorage Local DB" vertex="1">

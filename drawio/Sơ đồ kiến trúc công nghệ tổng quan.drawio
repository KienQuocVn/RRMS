        <!-- ==================== CLIENT LAYER ==================== -->
        <mxCell id="node_web_tech" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;align=center;" value="Web Frontend Application&#xa;[React JS &amp; Vite]&#xa;- Material UI (MUI)&#xa;- Axios HTTP Client&#xa;- Redux Toolkit / React Context" vertex="1">
          <mxGeometry x="90" y="110" width="220" height="100" as="geometry" />

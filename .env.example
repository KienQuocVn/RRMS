# --- Database (MySQL container: hostname = mysql) ---
DB_NAME=rrms
DB_USERNAME=root
DB_PASSWORD=rrms_secret
MYSQL_PORT=3307

# --- Redis (container: hostname = redis) ---
REDIS_PASSWORD=rrms_redis_secret
REDIS_PORT=6379

# --- Backend (Spring Boot container: hostname = backend) ---
PORT=7000
SPRING_PROFILES_ACTIVE=dev
JWT_SIGNER=your_secret_signer_key_here
# Cloudflare Turnstile secret — backend verify (khác VITE_SITE_KEY_CAPTCHA)
SECRET_KEY_CAPTCHA=your_turnstile_secret_key
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost

# --- Frontend (VITE_* bake vào image khi docker compose build; copy từ client/.env) ---
VITE_APP_API_URL=http://localhost:7000
VITE_PORT=5173
CLIENT_PORT=5173
VITE_REDIRECT_URI=http://localhost:5173/oauth2/redirect
VITE_SITE_KEY_CAPTCHA=your_turnstile_site_key

VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

VITE_FPT_AI_KEY=your_fpt_ai_key
VITE_FPT_APP_CODE=your_fpt_app_code

# OAuth web client (khác GOOGLE_CLIENT_ID của backend Spring)
VITE_GOOGLE_CLIENT_ID=your_google_web_client_id
VITE_FACEBOOK_APP_ID=your_facebook_app_id

TINY_API_KEY=your_tinymce_api_key

# --- Mail ---
MY_GMAIL=your_email@gmail.com
MY_PASSWORD_APP=your_app_password

# --- OAuth2 ---
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# --- Payment ---
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_SECRET=your_paypal_secret
PAYPAL_SUCCESS_URL=http://localhost:7000/payment/paypal/success
PAYPAL_CANCEL_URL=http://localhost:7000/payment/paypal/cancel

STRIPE_PUBLIC_KEY=your_stripe_public_key
STRIPE_SECRET_KEY=your_stripe_secret_key

MOMO_PARTNER_CODE=MOMOLRJZ20181206
MOMO_ACCESS_KEY=your_momo_access_key
MOMO_SECRET_KEY=your_momo_secret_key
MOMO_NOTIFY_URL=http://localhost:7000/payment/momo-notify
MOMO_RETURN_URL=http://localhost:7000/payment/paymentMoMoSuccess

VNPAY_SECRET_KEY=your_vnpay_secret_key
VNPAY_RETURN_URL=http://localhost:7000/payment/vnpay-callback

# When running `npx expo start --tunnel`, use a backend URL that the device can really reach.
# For the automatic workflow in this repo, prefer: npm run start:tunnel
# Examples:
# EXPO_PUBLIC_API_URL=http://192.168.1.22:7000
# EXPO_PUBLIC_API_URL=https://your-public-backend.ngrok-free.app
# A private 192.168.x.x URL only works when the phone is on the same Wi-Fi/LAN.
EXPO_PUBLIC_API_URL=http://192.168.1.22:7000

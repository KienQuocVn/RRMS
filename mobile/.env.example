# Optional override. Leave blank for normal `npm run start` so the app can auto-discover
# `http://<current Expo host>:7000`, emulator localhost, and the last successful API URL.
# `npm run start:tunnel` injects EXPO_PUBLIC_API_URL automatically at runtime.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_API_PORT=7000

# Optional comma-separated fallbacks when backend may run on another LAN machine.
# EXPO_PUBLIC_API_URL_CANDIDATES=http://192.168.1.22:7000,http://192.168.1.50:7000

# Optional health-check endpoint used by auto-discovery.
# EXPO_PUBLIC_API_PING_PATH=/authen/error

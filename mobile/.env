# Optional override. Leave blank to let mobile auto-discover the backend in `npm run start`.
# `npm run start:tunnel` injects its own public API URL automatically at runtime.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_API_PORT=7000
# EXPO_PUBLIC_API_URL_CANDIDATES=http://192.168.1.22:7000,http://192.168.1.50:7000
